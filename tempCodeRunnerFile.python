def min_coins(coins, amount):
    # Initialize DP array with float('inf') for amounts 0 to 'amount'
    dp = [float('inf')] * (amount + 1)
    
    # Base case: 0 amount requires 0 coins
    dp[0] = 0
    
    # Compute minimum coins for every amount from 1 to 'amount'
    for coin in coins:
        for x in range(coin, amount + 1):
            dp[x] = min(dp[x], dp[x - coin] + 1)
            
    # If dp[amount] is still infinity, it's impossible to make that change
    return dp[amount] if dp[amount] != float('inf') else -1

# Example usage
print(min_coins([1, 2, 5], 11))  # Output: 3 (5 + 5 + 1)